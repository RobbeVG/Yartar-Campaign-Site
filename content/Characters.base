filters:
  not:
    - file.inFolder("templates")
    - file.inFolder("0.DM Notes")
views:
  - type: cards
    name: Characters
    filters:
      and:
        - file.hasTag("PC")
    order:
      - file.name
      - Current Items
    image: note.socialImage
    imageAspectRatio: 1
    cardSize: 150
